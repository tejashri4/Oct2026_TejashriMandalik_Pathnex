#Ansible - Implementing SSH Keybased Authentication
- name: Implement SSH Key Authentication
  hosts: all
  become: yes
  tasks:
	- name: Generate SSH key pair
	  command: ssh-keygen -t rsa -b 2048 -f /home/user/.ssh/id_rsa -N ""
	- name: Add SSH public key to authorized_keys
	  authorized_key:
	  user: user
          state: present
	  key: "{{lookup('filr','/home/user/.ssh/id_rsa.pub')}}"



##Terrafrom - Enabling VPC Flow Logs for sercurity

resource "aws_vpc_flow_log" "pathnex_flow_log"
{
  log_group_name  = "pathnex_flow_log"
  vpc_id	  = aws_vpc.pathnex_vpc.id
  traffic_type    = "ALL"
  log_destination_type = "cloud-watch-logs"
}

resource "aws_cloudwatch_log_group" "pathnex_flow_logs_group"
{
  name = "pathnex-flow-logs"
}

##Kubernetes - Network Policies for Security
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
    name: pathnex-web-policy
spec:
  podSelector:
    matchLabels:
       app: pathnex-web-app
policyType:
- Ingress
- Egress
ingress:
 - from:
     - podSelector:
          matchLabels:
             app: pathnex-api

egress:
  - to:
      - podSelector:
          matchLabels:
                app: pathnex-database

